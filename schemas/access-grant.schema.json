{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Access Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","grant_id","approval_digest","subject_kind","subject_id","subject_role_version","subject_digest","asset_id","asset_version","asset_digest","purpose_id","purpose_version","purpose_digest","permissions","granted_by_id","valid_from","expires_at","evidence_digest","granted_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "grant_id": {"type":"string","minLength":1,"maxLength":256},
    "approval_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "subject_kind": {"enum":["principal","role"]},
    "subject_id": {"type":"string","minLength":1,"maxLength":256},
    "subject_role_version": {"type":["integer","null"],"minimum":1},
    "subject_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "asset_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_version": {"type":"integer","minimum":1},
    "asset_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "purpose_id": {"type":"string","minLength":1,"maxLength":256},
    "purpose_version": {"type":"integer","minimum":1},
    "purpose_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "permissions": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "granted_by_id": {"type":"string","minLength":1,"maxLength":256},
    "valid_from": {"type":"string","format":"date-time","pattern":"Z$"},
    "expires_at": {"anyOf":[{"type":"string","format":"date-time","pattern":"Z$"},{"type":"null"}]},
    "evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "granted_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"datagovops.access-grant.v1"}
  },
  "allOf": [
    {"if":{"properties":{"subject_kind":{"const":"principal"}}},"then":{"properties":{"subject_role_version":{"type":"null"}}}},
    {"if":{"properties":{"subject_kind":{"const":"role"}}},"then":{"properties":{"subject_role_version":{"type":"integer","minimum":1}}}}
  ]
}