{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps BCBS 239 Risk Data Aggregation Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institution_id",
    "portfolio_digest",
    "period_id",
    "report_assessment_digests",
    "report_attestation_digests",
    "portfolio_report_count",
    "represented_assessment_count",
    "met_report_count",
    "breached_report_count",
    "incomplete_report_count",
    "missing_assessment_count",
    "missing_attestation_count",
    "nonapproved_attestation_count",
    "state",
    "gaps",
    "assessed_at",
    "bcbs239_compliance_determined",
    "risk_data_accuracy_determined",
    "supervisory_acceptance_determined",
    "schema_version"
  ],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "portfolio_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "period_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "report_assessment_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "report_attestation_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "portfolio_report_count": {"type": "integer", "minimum": 1},
    "represented_assessment_count": {"type": "integer", "minimum": 0},
    "met_report_count": {"type": "integer", "minimum": 0},
    "breached_report_count": {"type": "integer", "minimum": 0},
    "incomplete_report_count": {"type": "integer", "minimum": 0},
    "missing_assessment_count": {"type": "integer", "minimum": 0},
    "missing_attestation_count": {"type": "integer", "minimum": 0},
    "nonapproved_attestation_count": {"type": "integer", "minimum": 0},
    "state": {"enum": ["met", "breached", "incomplete"]},
    "gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "assessed_at": {"type": "string", "format": "date-time"},
    "bcbs239_compliance_determined": {"const": false},
    "risk_data_accuracy_determined": {"const": false},
    "supervisory_acceptance_determined": {"const": false},
    "schema_version": {"const": "datagovops.bcbs239-aggregation-assessment.v1"}
  }
}
