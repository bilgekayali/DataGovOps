{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Classification Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","asset_id","asset_version","scope","element_id","target_digest","classification","decision_owner_id","rationale","evidence_digest","decided_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_version": {"type":"integer","minimum":1},
    "scope": {"enum":["asset","data_element"]},
    "element_id": {"type":["string","null"],"minLength":1,"maxLength":256},
    "target_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "classification": {"enum":["public","internal","confidential","restricted"]},
    "decision_owner_id": {"type":"string","minLength":1,"maxLength":256},
    "rationale": {"type":"string","minLength":1,"maxLength":1024},
    "evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decided_at": {"type":"string","format":"date-time"},
    "schema_version": {"const":"datagovops.classification-decision.v1"}
  },
  "allOf": [
    {"if":{"properties":{"scope":{"const":"asset"}}},"then":{"properties":{"element_id":{"type":"null"}}}},
    {"if":{"properties":{"scope":{"const":"data_element"}}},"then":{"properties":{"element_id":{"type":"string","minLength":1,"maxLength":256}}}}
  ]
}
