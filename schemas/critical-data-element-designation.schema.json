{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Critical Data Element Designation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","asset_id","asset_version","element_id","element_digest","cde_owner_id","decision_owner_id","rationale","evidence_digest","designated_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_version": {"type":"integer","minimum":1},
    "element_id": {"type":"string","minLength":1,"maxLength":256},
    "element_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "cde_owner_id": {"type":"string","minLength":1,"maxLength":256},
    "decision_owner_id": {"type":"string","minLength":1,"maxLength":256},
    "rationale": {"type":"string","minLength":1,"maxLength":1024},
    "evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "designated_at": {"type":"string","format":"date-time"},
    "schema_version": {"const":"datagovops.critical-data-element-designation.v1"}
  }
}
