{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Data Asset Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "institution_id", "asset_id", "name", "data_domain", "owner_id", "steward_id", "system_of_record", "classification", "criticality", "contains_personal_data", "source_of_truth", "retention_policy_id", "quality_owner_id", "registered_at"],
  "properties": {
    "schema_version": {"const": "datagovops.data-asset-record.v1"},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "asset_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "name": {"type": "string", "minLength": 1, "maxLength": 512},
    "data_domain": {"type": "string", "minLength": 1, "maxLength": 256},
    "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "steward_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "system_of_record": {"type": "string", "minLength": 1, "maxLength": 256},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "criticality": {"enum": ["low", "moderate", "high", "critical"]},
    "contains_personal_data": {"type": "boolean"},
    "source_of_truth": {"type": "boolean"},
    "retention_policy_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "quality_owner_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "registered_at": {"type": "string", "format": "date-time"}
  }
}
