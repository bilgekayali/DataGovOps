{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datagovops.dev/schemas/data-asset-record.schema.json",
  "title": "DataGovOps Data Asset Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "institution_id",
    "asset_id",
    "asset_version",
    "name",
    "data_domain",
    "owner_id",
    "steward_id",
    "system_of_record_id",
    "classification",
    "classification_decision_owner_id",
    "classification_rationale",
    "criticality",
    "criticality_decision_owner_id",
    "criticality_rationale",
    "contains_personal_data",
    "source_of_truth",
    "retention_policy_id",
    "quality_owner_id",
    "registered_at"
  ],
  "properties": {
    "schema_version": {"const": "datagovops.data-asset-record.v1"},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "asset_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "asset_version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 512},
    "data_domain": {"type": "string", "minLength": 1, "maxLength": 256},
    "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "steward_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "system_of_record_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "classification_decision_owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "classification_rationale": {"type": "string", "minLength": 1, "maxLength": 1024},
    "criticality": {"enum": ["low", "moderate", "high", "critical"]},
    "criticality_decision_owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "criticality_rationale": {"type": "string", "minLength": 1, "maxLength": 1024},
    "contains_personal_data": {"type": "boolean"},
    "source_of_truth": {"type": "boolean"},
    "retention_policy_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 256}
      ]
    },
    "quality_owner_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 256}
      ]
    },
    "registered_at": {"type": "string", "format": "date-time"}
  }
}
