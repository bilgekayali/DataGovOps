{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Data Element Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","asset_id","asset_version","element_id","name","data_type","owner_id","nullable","registered_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_version": {"type":"integer","minimum":1},
    "element_id": {"type":"string","minLength":1,"maxLength":256},
    "name": {"type":"string","minLength":1,"maxLength":512},
    "data_type": {"type":"string","minLength":1,"maxLength":256},
    "owner_id": {"type":"string","minLength":1,"maxLength":256},
    "nullable": {"type":"boolean"},
    "registered_at": {"type":"string","format":"date-time"},
    "schema_version": {"const":"datagovops.data-element-record.v1"}
  }
}
