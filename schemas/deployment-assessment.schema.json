{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Deployment Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","environment_id","workload_id","evidence_sha256","state","controls","assessed_at","requires_human_review","production_effectiveness_determined","supply_chain_security_determined","regulatory_compliance_determined","schema_version"],
  "properties": {
    "institution_id":{"type":"string","minLength":1,"maxLength":256},
    "environment_id":{"type":"string","minLength":1,"maxLength":256},
    "workload_id":{"type":"string","minLength":1,"maxLength":256},
    "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "state":{"enum":["represented","incomplete"]},
    "controls":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["control_id","state","rationale"],
        "properties":{
          "control_id":{"type":"string","minLength":1,"maxLength":256},
          "state":{"enum":["represented","gap"]},
          "rationale":{"type":"string","minLength":1,"maxLength":1024}
        }
      }
    },
    "assessed_at":{"type":"integer","minimum":0},
    "requires_human_review":{"const":true},
    "production_effectiveness_determined":{"const":false},
    "supply_chain_security_determined":{"const":false},
    "regulatory_compliance_determined":{"const":false},
    "schema_version":{"const":"datagovops.deployment-assessment.v1"}
  }
}
