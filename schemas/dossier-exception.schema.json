{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Dossier Exception v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","exception_id","owner_id","finding_codes","rationale","approved_at","expires_at","evidence_digest","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "exception_id": {"type":"string","minLength":1,"maxLength":256},
    "owner_id": {"type":"string","minLength":1,"maxLength":256},
    "finding_codes": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024}},
    "rationale": {"type":"string","minLength":1,"maxLength":2048},
    "approved_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":"string","format":"date-time"},
    "evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "schema_version": {"const":"datagovops.dossier-exception.v1"}
  }
}
