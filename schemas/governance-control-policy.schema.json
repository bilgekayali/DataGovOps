{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Governance Control Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","policy_id","policy_version","owner_id","require_retention_schedule","require_obligation_mapping_for_personal_data","require_location_evidence_for_personal_data","evidence_digest","registered_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "policy_id": {"type":"string","minLength":1,"maxLength":256},
    "policy_version": {"type":"integer","minimum":1},
    "owner_id": {"type":"string","minLength":1,"maxLength":256},
    "require_retention_schedule": {"type":"boolean"},
    "require_obligation_mapping_for_personal_data": {"type":"boolean"},
    "require_location_evidence_for_personal_data": {"type":"boolean"},
    "evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "registered_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"datagovops.governance-control-policy.v1"}
  }
}