{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Governance Dossier Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dossier","dossier_digest"],
  "properties": {
    "dossier": {"$ref":"#/$defs/dossier"},
    "dossier_digest": {"$ref":"#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "domain": {"enum":["access_retention_privacy","assurance","inventory","lineage","quality","reporting","semantic"]},
    "artifact": {
      "type":"object",
      "additionalProperties":false,
      "required":["domain","artifact_type","artifact_id","payload","digest"],
      "properties":{
        "domain":{"$ref":"#/$defs/domain"},
        "artifact_type":{"type":"string","minLength":1,"maxLength":256},
        "artifact_id":{"$ref":"#/$defs/digest"},
        "payload":{"type":"object"},
        "digest":{"$ref":"#/$defs/digest"}
      }
    },
    "domain_snapshot": {
      "type":"object",
      "additionalProperties":false,
      "required":["domain","source_snapshot_digest","artifact_digests"],
      "properties":{
        "domain":{"$ref":"#/$defs/domain"},
        "source_snapshot_digest":{"$ref":"#/$defs/digest"},
        "artifact_digests":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/digest"}}
      }
    },
    "exception": {
      "type":"object",
      "additionalProperties":false,
      "required":["institution_id","exception_id","owner_id","finding_codes","rationale","approved_at","expires_at","evidence_digest","schema_version"],
      "properties":{
        "institution_id":{"type":"string","minLength":1,"maxLength":256},
        "exception_id":{"type":"string","minLength":1,"maxLength":256},
        "owner_id":{"type":"string","minLength":1,"maxLength":256},
        "finding_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024}},
        "rationale":{"type":"string","minLength":1,"maxLength":2048},
        "approved_at":{"type":"string","format":"date-time"},
        "expires_at":{"type":"string","format":"date-time"},
        "evidence_digest":{"$ref":"#/$defs/digest"},
        "schema_version":{"const":"datagovops.dossier-exception.v1"}
      }
    },
    "coverage": {
      "type":"object",
      "additionalProperties":false,
      "properties":{
        "access_retention_privacy":{"type":"integer","minimum":0},
        "assurance":{"type":"integer","minimum":0},
        "inventory":{"type":"integer","minimum":0},
        "lineage":{"type":"integer","minimum":0},
        "quality":{"type":"integer","minimum":0},
        "reporting":{"type":"integer","minimum":0},
        "semantic":{"type":"integer","minimum":0}
      }
    },
    "dossier": {
      "type":"object",
      "additionalProperties":false,
      "required":["schema_version","release_version","institution_id","generated_at","source_revision","state","findings","revalidation_findings","active_exception_digests","coverage","domain_snapshots","artifacts","exceptions","legal_compliance_determined"],
      "properties":{
        "schema_version":{"const":"datagovops.governance-dossier.v1"},
        "release_version":{"const":"0.2.0"},
        "institution_id":{"type":"string","minLength":1,"maxLength":256},
        "generated_at":{"type":"string","format":"date-time"},
        "source_revision":{"type":"string","minLength":1,"maxLength":256},
        "state":{"enum":["current","with_gaps","with_exceptions","revalidation_required"]},
        "findings":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024}},
        "revalidation_findings":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024}},
        "active_exception_digests":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/digest"}},
        "coverage":{"$ref":"#/$defs/coverage"},
        "domain_snapshots":{"type":"array","minItems":6,"maxItems":7,"items":{"$ref":"#/$defs/domain_snapshot"}},
        "artifacts":{"type":"array","items":{"$ref":"#/$defs/artifact"}},
        "exceptions":{"type":"array","items":{"$ref":"#/$defs/exception"}},
        "legal_compliance_determined":{"const":false}
      }
    }
  }
}
