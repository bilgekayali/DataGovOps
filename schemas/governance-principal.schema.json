{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datagovops.dev/schemas/governance-principal.schema.json",
  "title": "DataGovOps Governance Principal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "institution_id", "principal_id", "display_name", "principal_type", "registered_at"],
  "properties": {
    "schema_version": {"const": "datagovops.governance-principal.v1"},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "principal_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 512},
    "principal_type": {"enum": ["human", "team", "service"]},
    "registered_at": {"type": "string", "format": "date-time"}
  }
}
