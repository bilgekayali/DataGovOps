{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Legal Hold v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","hold_id","asset_id","asset_version","asset_digest","owner_id","rationale","evidence_digest","starts_at","recorded_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "hold_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_version": {"type":"integer","minimum":1},
    "asset_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "owner_id": {"type":"string","minLength":1,"maxLength":256},
    "rationale": {"type":"string","minLength":1,"maxLength":2048},
    "evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "starts_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "recorded_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"datagovops.legal-hold.v1"}
  }
}