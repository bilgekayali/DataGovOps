{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Lineage Completeness Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","lineage_snapshot_digest","requirement_digests","missing_requirement_ids","stale_requirement_ids","complete","evaluated_at","regulatory_compliance_determined","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "lineage_snapshot_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "requirement_digests": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "missing_requirement_ids": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "stale_requirement_ids": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "complete": {"type":"boolean"},
    "evaluated_at": {"type":"string","format":"date-time"},
    "regulatory_compliance_determined": {"const":false},
    "schema_version": {"const":"datagovops.lineage-completeness-report.v1"}
  }
}