{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"DataGovOps Quality Evaluation Policy v1","type":"object","additionalProperties":false,
  "required":["institution_id","policy_id","policy_version","owner_id","missing_observation_treatment","stale_observation_treatment","freshness_grace_seconds","evidence_digest","registered_at","schema_version"],
  "properties":{
    "institution_id":{"type":"string","minLength":1,"maxLength":256},
    "policy_id":{"type":"string","minLength":1,"maxLength":256},
    "policy_version":{"type":"integer","minimum":1},
    "owner_id":{"type":"string","minLength":1,"maxLength":256},
    "missing_observation_treatment":{"enum":["incomplete","breach"]},
    "stale_observation_treatment":{"enum":["incomplete","breach"]},
    "freshness_grace_seconds":{"type":"integer","minimum":0},
    "evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "registered_at":{"type":"string","format":"date-time"},
    "schema_version":{"const":"datagovops.quality-evaluation-policy.v1"}
  }
}