{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"DataGovOps Quality Finding v1","type":"object","additionalProperties":false,
  "required":["institution_id","finding_id","evaluation_digest","rule_digest","severity","owner_id","title","identified_at","evidence_digest","schema_version"],
  "properties":{
    "institution_id":{"type":"string","minLength":1,"maxLength":256},
    "finding_id":{"type":"string","minLength":1,"maxLength":256},
    "evaluation_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "rule_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "severity":{"enum":["low","medium","high","critical"]},
    "owner_id":{"type":"string","minLength":1,"maxLength":256},
    "title":{"type":"string","minLength":1,"maxLength":512},
    "identified_at":{"type":"string","format":"date-time"},
    "evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "schema_version":{"const":"datagovops.quality-finding.v1"}
  }
}