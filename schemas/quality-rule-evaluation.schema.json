{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"DataGovOps Quality Rule Evaluation v1","type":"object","additionalProperties":false,
  "required":["institution_id","rule_id","rule_version","rule_digest","target_digest","policy_digest","observation_digest","state","reason_code","evaluated_at","regulatory_compliance_determined","schema_version"],
  "properties":{
    "institution_id":{"type":"string","minLength":1,"maxLength":256},
    "rule_id":{"type":"string","minLength":1,"maxLength":256},
    "rule_version":{"type":"integer","minimum":1},
    "rule_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "target_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "policy_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "observation_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "state":{"enum":["passed","breached","incomplete"]},
    "reason_code":{"type":"string","minLength":1,"maxLength":256},
    "evaluated_at":{"type":"string","format":"date-time"},
    "regulatory_compliance_determined":{"const":false},
    "schema_version":{"const":"datagovops.quality-rule-evaluation.v1"}
  }
}