{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Recovery Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","policy_id","policy_version","owner_id","maximum_rpo_seconds","maximum_rto_seconds","maximum_backup_age_seconds","minimum_retention_seconds","approved_at","schema_version","production_effectiveness_determined"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "policy_id": {"type":"string","minLength":1,"maxLength":256},
    "policy_version": {"type":"integer","minimum":1},
    "owner_id": {"type":"string","minLength":1,"maxLength":256},
    "maximum_rpo_seconds": {"type":"integer","minimum":1},
    "maximum_rto_seconds": {"type":"integer","minimum":1},
    "maximum_backup_age_seconds": {"type":"integer","minimum":1},
    "minimum_retention_seconds": {"type":"integer","minimum":1},
    "approved_at": {"type":"integer","minimum":0},
    "schema_version": {"const":"datagovops.recovery-policy.v1"},
    "production_effectiveness_determined": {"const":false}
  }
}
