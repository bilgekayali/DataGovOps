{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Restore Verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","restore_id","backup_digest","expected_state_digest","recovered_state_digest","started_at","completed_at","verifier_id","verification_evidence_digest","schema_version","production_restore_verified"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "restore_id": {"type":"string","minLength":1,"maxLength":256},
    "backup_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "expected_state_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "recovered_state_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "started_at": {"type":"integer","minimum":0},
    "completed_at": {"type":"integer","minimum":0},
    "verifier_id": {"type":"string","minLength":1,"maxLength":256},
    "verification_evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "schema_version": {"const":"datagovops.restore-verification.v1"},
    "production_restore_verified": {"const":false}
  }
}
