{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataGovOps Retention Schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","schedule_id","schedule_version","asset_id","asset_version","asset_digest","owner_id","retention_trigger_at","retention_days","rationale","evidence_digest","registered_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "schedule_id": {"type":"string","minLength":1,"maxLength":256},
    "schedule_version": {"type":"integer","minimum":1},
    "asset_id": {"type":"string","minLength":1,"maxLength":256},
    "asset_version": {"type":"integer","minimum":1},
    "asset_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "owner_id": {"type":"string","minLength":1,"maxLength":256},
    "retention_trigger_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "retention_days": {"type":"integer","minimum":1},
    "rationale": {"type":"string","minLength":1,"maxLength":2048},
    "evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "registered_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"datagovops.retention-schedule.v1"}
  }
}